# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it holds real secrets.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Public (safe to expose to the browser — only grants what RLS allows).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional newer key name; the app falls back to it if ANON_KEY is unset.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only (bypasses RLS). NEVER prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# ── Vercel Cron ───────────────────────────────────────────────────────────────
# Shared secret for the daily reaper route (app/api/cron/reap-posts).
# Set the SAME value in the Vercel project env vars so the cron can authenticate.
CRON_SECRET=

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# Public key is exposed to the browser; private key is server-only (never
# NEXT_PUBLIC). Set BOTH in the Vercel project env vars for prod push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
